# Application Settings
LOGISUIEL_DEBUG=False
LOGISUIEL_APP_NAME="LogiSuiEl API"

# CORS Settings (comma-separated list of allowed origins)
# For development, you can use ["http://localhost:5173","http://127.0.0.1:5173"]
# For production, specify your frontend domain
LOGISUIEL_BACKEND_CORS_ORIGINS=[]

# Database
LOGISUIEL_DATABASE_URL=sqlite+aiosqlite:///./logisuiel.db

# JWT Token Settings
LOGISUIEL_TOKENS__SECRET_KEY=change-me-in-production
LOGISUIEL_TOKENS__ALGORITHM=HS256
LOGISUIEL_TOKENS__ACCESS_TOKEN_EXPIRE_MINUTES=30
LOGISUIEL_TOKENS__REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Default Admin Account
LOGISUIEL_ADMIN_DEFAULT_USERNAME=admin
LOGISUIEL_ADMIN_DEFAULT_PASSWORD=admin

# Default Teacher Account
LOGISUIEL_TEACHER_DEFAULT_USERNAME=test
LOGISUIEL_TEACHER_DEFAULT_PASSWORD=test
